{
  "name": "dsh-statusbar-config",
  "version": "0.4.0",
  "description": "Session, post-compaction Window and per-Turn token usage for DeepSeek Harness",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "lib",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.tests.json",
    "check": "node scripts/check.mjs all",
    "test": "node scripts/check.mjs test",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:dist": "node scripts/check.mjs dist"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "status-bar",
    "stats",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.7-0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "homepage": "https://github.com/iBobbyTS/dsh-statusbar-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-statusbar-config.git"
  },
  "bugs": "https://github.com/iBobbyTS/dsh-statusbar-config/issues",
  "author": "MannixHu",
  "dependencies": {
    "zod": "^4.5.4"
  },
  "packageManager": "pnpm@10.28.2"
}
